<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <Characters>
        <!-- Sharks -->
        <Character>
            <Id>
                <TypeId>MyObjectBuilder_Character</TypeId>
                <SubtypeId>AquaWhiteShark</SubtypeId>
            </Id>
			<AnimationController>Aqua_WhiteShark</AnimationController>
            <Name>WhiteShark</Name>
            <Model>Models\Characters\WhiteShark.mwm</Model>
			<!--<DeathSoundName>BotWolfDeath</DeathSoundName>-->
			<HeadServerOffset>0.25</HeadServerOffset>
            <LoopingFootsteps>true</LoopingFootsteps>
            <PhysicalMaterial>Wolf</PhysicalMaterial>
            <Mass>300</Mass>
            <MaxHealth>200</MaxHealth>
            <LootingTime>200</LootingTime>
            <Skeleton>Arachnid</Skeleton>
            <SpineBone>SpineCenter</SpineBone>
            <EnableFirstPersonView>false</EnableFirstPersonView>
            <AnimationMappings>
				<Mapping Name="Idle" AnimationSubtypeName="IdleShark" />
				<Mapping Name="Run" AnimationSubtypeName="BoostShark" />
				<Mapping Name="Walk" AnimationSubtypeName="SwimShark" />
				<Mapping Name="Attack" AnimationSubtypeName="AttackShark" />
				<Mapping Name="Died" AnimationSubtypeName="DeathShark" />
            </AnimationMappings>
            <VisibleOnHud>false</VisibleOnHud>
            <UsableByPlayer>false</UsableByPlayer>
			<Inventory>
                <InventoryVolume>1</InventoryVolume>
                <!-- in m3 ! -->
                <InventoryMass>50</InventoryMass>
            </Inventory>
            <!-- ENABLED COMPONENTS -->
            <EnabledComponents>RagdollComponent</EnabledComponents>
            <!-- BONES -->
            <HeadBone>Head</HeadBone>
            <ModelRootBoneName>Shark_DummyRoot</ModelRootBoneName>
            <!-- Character control -->
            <VerticalPositionFlyingOnly>false</VerticalPositionFlyingOnly>
            <UseOnlyWalking>false</UseOnlyWalking>
            <MaxSlope>90</MaxSlope>
            <MaxSprintSpeed>20</MaxSprintSpeed>
            <MaxRunSpeed>10</MaxRunSpeed>
            <MaxBackrunSpeed>8</MaxBackrunSpeed>
            <MaxRunStrafingSpeed>6</MaxRunStrafingSpeed>
            <MaxWalkSpeed>10</MaxWalkSpeed>
            <MaxBackwalkSpeed>8</MaxBackwalkSpeed>
            <MaxWalkStrafingSpeed>6</MaxWalkStrafingSpeed>
            <MaxCrouchWalkSpeed>10</MaxCrouchWalkSpeed>
            <MaxCrouchBackwalkSpeed>10</MaxCrouchBackwalkSpeed>
            <MaxCrouchStrafingSpeed>6</MaxCrouchStrafingSpeed>
			<CharacterHeadSize>0.35</CharacterHeadSize>
			<CharacterHeadHeight>0.0</CharacterHeadHeight>
			<CharacterCollisionScale>0.8</CharacterCollisionScale>
			<CharacterCollisionHeight>0.5</CharacterCollisionHeight>
			<CharacterCollisionWidth>0.5</CharacterCollisionWidth>
			<OxygenConsumption>0.0</OxygenConsumption>
			<OxygenConsumptionMultiplier>0</OxygenConsumptionMultiplier>
			<PressureLevelForLowDamage>0.0</PressureLevelForLowDamage>
			<DamageAmountAtZeroPressure>0.0</DamageAmountAtZeroPressure>
			<NeedsOxygen>false</NeedsOxygen>
			<BoneSet>
                <Name>Body</Name>
            </BoneSet>
            <InitialAnimation>Idle</InitialAnimation>
            <!--
      <RagdollRootBody>Ragdoll_deer_Pelvis001</RagdollRootBody>
      <RagdollDataFile>Models\Characters\Basic\ME_Deer_ragdoll.hkt</RagdollDataFile>
      -->
            <RagdollBonesMappings>
				<BoneSet>
					<Name>JawUp</Name>
					<Bones>JawUp JawDown</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>Jawbase</Name>
					<Bones>Jawbase Head</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>Head</Name>
					<Bones>Head SpineToHead</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineToHead</Name>
					<Bones>SpineToHead SpineMid</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineMid</Name>
					<Bones>SpineMid SpineCenter</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineCenter</Name>
					<Bones>SpineCenter SpineToTail</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineToTail</Name>
					<Bones>SpineToTail TailStart</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>TailStart</Name>
					<Bones>TailStart TailMid</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>TailMid</Name>
					<Bones>TailMid TailEnd</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>TailUpFin</Name>
					<Bones>TailUpFin TailDownFin</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>RearFinsSpine</Name>
					<Bones>SpineToTail RearFinsSpine</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>RearArmL</Name>
					<Bones>RearFinsSpine RearArmLStart</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>RearArmR</Name>
					<Bones>RearFinsSpine RearArmRStart</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>RearArmLFins</Name>
					<Bones>RearArmLFinR RearArmLFinL</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>RearArmRFins</Name>
					<Bones>RearArmRFinR RearArmRFinL</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineToMainFin</Name>
					<Bones>SpineCenter SpineToMainFin</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>MainFin</Name>
					<Bones>SpineToMainFin MainFin</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineToArmL</Name>
					<Bones>SpineCenter SpineToArmL</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineToArmR</Name>
					<Bones>SpineCenter SpineToArmR</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>ArmL</Name>
					<Bones>SpineToArmL ArmLStart</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>ArmR</Name>
					<Bones>SpineToArmR ArmRStart</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>ArmLFin</Name>
					<Bones>ArmLStart ArmLFin</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>ArmRFin</Name>
					<Bones>ArmRStart ArmRFin</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
            </RagdollBonesMappings>
            <DeadBodyShape>
                <BoxShapeScale x="0.8" y="0.45" z="3.2"/>
                <RelativeCenterOfMass x="0" y="0" z="0"/>
                <RelativeShapeTranslation x="0" y="-0.5" z="0"/>
                <Friction>30</Friction>
            </DeadBodyShape>
            <RotationToSupport>Full</RotationToSupport>
        </Character>
		
		<Character>
            <Id>
                <TypeId>MyObjectBuilder_Character</TypeId>
                <SubtypeId>AquaWhaleShark</SubtypeId>
            </Id>
			<AnimationController>Aqua_WhaleShark</AnimationController>
            <Name>AWhaleShark</Name>
            <Model>Models\Characters\AWhaleShark.mwm</Model>
			<!--<DeathSoundName>BotWolfDeath</DeathSoundName>-->
			<HeadServerOffset>0.25</HeadServerOffset>
            <LoopingFootsteps>true</LoopingFootsteps>
            <PhysicalMaterial>Wolf</PhysicalMaterial>
            <Mass>300</Mass>
            <MaxHealth>500</MaxHealth>
            <LootingTime>200</LootingTime>
            <Skeleton>Arachnid</Skeleton>
            <SpineBone>SpineCenter</SpineBone>
            <EnableFirstPersonView>false</EnableFirstPersonView>
            <AnimationMappings>
				<Mapping Name="Idle" AnimationSubtypeName="IdleWhaleShark" />
				<Mapping Name="Run" AnimationSubtypeName="BoostWhaleShark" />
				<Mapping Name="Walk" AnimationSubtypeName="SwimWhaleShark" />
				<Mapping Name="Attack" AnimationSubtypeName="AttackWhaleShark" />
				<Mapping Name="Died" AnimationSubtypeName="DeathWhaleShark" />
            </AnimationMappings>
            <VisibleOnHud>false</VisibleOnHud>
            <UsableByPlayer>false</UsableByPlayer>
			<Inventory>
                <InventoryVolume>1</InventoryVolume>
                <!-- in m3 ! -->
                <InventoryMass>50</InventoryMass>
            </Inventory>
            <!-- ENABLED COMPONENTS -->
            <EnabledComponents>RagdollComponent</EnabledComponents>
            <!-- BONES -->
            <HeadBone>Head</HeadBone>
            <ModelRootBoneName>SE_SharkRoot</ModelRootBoneName>
            <!-- Character control -->
            <VerticalPositionFlyingOnly>false</VerticalPositionFlyingOnly>
            <UseOnlyWalking>false</UseOnlyWalking>
            <MaxSlope>90</MaxSlope>
            <MaxSprintSpeed>20</MaxSprintSpeed>
            <MaxRunSpeed>10</MaxRunSpeed>
            <MaxBackrunSpeed>8</MaxBackrunSpeed>
            <MaxRunStrafingSpeed>6</MaxRunStrafingSpeed>
            <MaxWalkSpeed>10</MaxWalkSpeed>
            <MaxBackwalkSpeed>8</MaxBackwalkSpeed>
            <MaxWalkStrafingSpeed>6</MaxWalkStrafingSpeed>
            <MaxCrouchWalkSpeed>10</MaxCrouchWalkSpeed>
            <MaxCrouchBackwalkSpeed>10</MaxCrouchBackwalkSpeed>
            <MaxCrouchStrafingSpeed>6</MaxCrouchStrafingSpeed>
			<CharacterHeadSize>0.6</CharacterHeadSize>
			<CharacterHeadHeight>0.0</CharacterHeadHeight>
			<CharacterCollisionScale>1.1</CharacterCollisionScale>
			<CharacterCollisionHeight>2.0</CharacterCollisionHeight>
			<CharacterCollisionWidth>1.0</CharacterCollisionWidth>
			<OxygenConsumption>0.0</OxygenConsumption>
			<OxygenConsumptionMultiplier>0</OxygenConsumptionMultiplier>
			<PressureLevelForLowDamage>0.0</PressureLevelForLowDamage>
			<DamageAmountAtZeroPressure>0.0</DamageAmountAtZeroPressure>
			<NeedsOxygen>false</NeedsOxygen>
			<BoneSet>
                <Name>Body</Name>
            </BoneSet>
            <InitialAnimation>Idle</InitialAnimation>
            <!--
      <RagdollRootBody>Ragdoll_deer_Pelvis001</RagdollRootBody>
      <RagdollDataFile>Models\Characters\Basic\ME_Deer_ragdoll.hkt</RagdollDataFile>
      -->
            <RagdollBonesMappings>
				<BoneSet>
					<Name>Head2Jaws</Name>
					<Bones>Head2Jaws Head</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>Head</Name>
					<Bones>Head Spinehead</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>Spinehead</Name>
					<Bones>Spinehead SpineMid2</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineMid2</Name>
					<Bones>SpineMid2 SpineMid</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineMid</Name>
					<Bones>SpineMid SpineCenter</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>SpineCenter</Name>
					<Bones>SpineCenter SharkRoot</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>Spine2Tail</Name>
					<Bones>Spine2Tail SpineCenter</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>Tail</Name>
					<Bones>Spine2Tail Tail</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>TallEnd</Name>
					<Bones>Tail TallEnd</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>TailDownFin</Name>
					<Bones>TallEnd TailDownFin</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>TailTopFin</Name>
					<Bones>TallEnd TailTopFin</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>Spine2TopFin</Name>
					<Bones>SpineCenter Spine2TopFin</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>TopFin</Name>
					<Bones>Spine2TopFin TopFin</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>Spine2ArmRight</Name>
					<Bones>SpineMid2 Spine2ArmRight</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>ArmRight</Name>
					<Bones>Spine2ArmRight ArmRight</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
				<BoneSet>
					<Name>ArmLeft</Name>
					<Bones>Spine2ArmLeft ArmLeft</Bones>
					<CollisionRadius>0.25</CollisionRadius>
				</BoneSet>
            </RagdollBonesMappings>
            <DeadBodyShape>
                <BoxShapeScale x="1.5" y="0.7" z="7.0"/>
                <RelativeCenterOfMass x="0" y="0" z="0"/>
                <RelativeShapeTranslation x="0" y="-0.5" z="-2"/>
                <Friction>50</Friction>
            </DeadBodyShape>
            <RotationToSupport>Full</RotationToSupport>
        </Character>
    </Characters>
</Definitions>

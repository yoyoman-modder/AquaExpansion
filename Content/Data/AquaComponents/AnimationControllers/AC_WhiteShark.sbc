          <Node>
            <Name>all</Name>
            <EdPos>
              <X>419</X>
              <Y>223</Y>
            </EdPos>
            <Type>AnyExceptTarget</Type>
            <Variables />
          </Node>
          <Node>
            <Name>Idle</Name>
            <StateMachineName>SMWhiteSharkIdle</StateMachineName>
            <EdPos>
              <X>-41</X>
              <Y>24</Y>
            </EdPos>
            <Type>Normal</Type>
            <Variables />
          </Node>
          <Node>
            <Name>Start</Name>
            <EdPos>
              <X>-30</X>
              <Y>-81</Y>
            </EdPos>
            <Type>PassThrough</Type>
            <Variables />
          </Node>
        </Nodes>
        <Transitions>
          <Transition Name="Attack" From="Move" To="Attack" TimeInSec="0.1" Sync="Restart" Curve="Smooth">
            <Priority xsi:nil="true" />
          </Transition>
          <Transition From="Attack" To="Move" TimeInSec="0.2" Sync="NoSynchonization" Curve="Smooth">
            <Conditions>
              <Conjunction>
                <Condition Lhs="Speed" Op="GreaterOrEqual" Rhs="1.5" />
                <Condition Lhs="@AnimationFinished" Op="Greater" Rhs="0.5" />
              </Conjunction>
            </Conditions>
            <Priority xsi:nil="true" />
          </Transition>
          <Transition From="all" To="Death" TimeInSec="0.2" Sync="Restart" Curve="Smooth">
            <Conditions>
              <Conjunction>
                <Condition Lhs="dead" Op="Equal" Rhs="1" />
              </Conjunction>
            </Conditions>
            <Priority>1</Priority>
          </Transition>
          <Transition From="Attack" To="Idle/Idle1" TimeInSec="0.2" Sync="Restart" Curve="Smooth">
            <Conditions>
              <Conjunction>
                <Condition Lhs="@AnimationFinished" Op="Equal" Rhs="1" />
                <Condition Lhs="Speed" Op="Less" Rhs="1.5" />
              </Conjunction>
            </Conditions>
            <Priority xsi:nil="true" />
          </Transition>
          <Transition From="Move" To="Idle/Idle1" TimeInSec="0.3" Sync="Restart" Curve="Smooth">
            <Conditions>
              <Conjunction>
                <Condition Lhs="Speed" Op="Less" Rhs="0.9" />
              </Conjunction>
            </Conditions>
            <Priority xsi:nil="true" />
          </Transition>
          <Transition Name="Attack" From="Idle/Any" To="Attack" TimeInSec="0.1" Sync="Restart" Curve="Smooth">
            <Priority xsi:nil="true" />
          </Transition>
          <Transition From="Start" To="Idle/Idle1" TimeInSec="0" Sync="Restart" Curve="Smooth">
            <Conditions>
              <Conjunction>
                <Condition Op="AlwaysTrue" />
              </Conjunction>
            </Conditions>
            <Priority xsi:nil="true" />
          </Transition>
          <Transition From="Idle/Any" To="Move" TimeInSec="0.2" Sync="Restart" Curve="Smooth">
            <Conditions>
              <Conjunction>
                <Condition Lhs="speed" Op="Greater" Rhs="0.95" />
              </Conjunction>
            </Conditions>
            <Priority xsi:nil="true" />
          </Transition>
        </Transitions>
      </StateMachine>

    <AmmoMagazines>
        <AmmoMagazine>
            <Id>
                <TypeId>AmmoMagazine</TypeId>
                <SubtypeId>AquaSmallTorpedo</SubtypeId>
            </Id>
            <DisplayName>Small Torpedo</DisplayName>
            <Icon>Textures\GUI\Icons\ammo\Small_Rocket.dds</Icon>
			<IconSymbol>SEA</IconSymbol>

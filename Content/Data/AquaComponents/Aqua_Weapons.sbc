			<SecondarySoundName>WepShipGatlingRotation</SecondarySoundName>
			<Effects>
				<Effect Action="Shoot" Dummy="muzzle_projectile" Particle="" Loop="true" InstantStop="true" OffsetX="0" OffsetY="0" OffsetZ="-1" />
				<Effect Action="Shoot" Dummy="None" Particle="" Loop="true" InstantStop="false"
                OffsetX="0.09" OffsetY="0" OffsetZ="-1.2"
                ParticleBirthStart="1" ParticleBirthMin="1" ParticleBirthMax="2" ParticleBirthDecrease="1" ParticleBirthIncrease="1" />
			</Effects>
			<AmmoMagazines>
				<AmmoMagazine Subtype="NATO_25x184mm" />
			</AmmoMagazines>
		</Weapon>
		<Weapon>
			<Id>
				<TypeId>WeaponDefinition</TypeId>
				<SubtypeId>GatlingGunWarfare</SubtypeId>
			</Id>
			<ProjectileAmmoData RateOfFire="700" ShootSoundName="WepShipGatlingShot" ShotsInBurst="140" />
			<ReleaseTimeAfterFire>204</ReleaseTimeAfterFire>
			<DeviateShotAngle>0.15</DeviateShotAngle>
			<DeviateShotAngleAiming>0.15</DeviateShotAngleAiming>
			<MuzzleFlashLifeSpan>40</MuzzleFlashLifeSpan>
			<NoAmmoSoundName>WepShipGatlingNoAmmo</NoAmmoSoundName>
			<SecondarySoundName>WepShipGatlingRotation</SecondarySoundName>

			<Effects>
				<Effect Action="Shoot" Dummy="muzzle_projectile" Particle="" Loop="true" InstantStop="true" OffsetX="0" OffsetY="0" OffsetZ="-1.5"/>
				<Effect Action="Shoot" Dummy="None" Particle="" Loop="true" InstantStop="false" OffsetX="0.1" OffsetY="0" OffsetZ="-1.5"
                ParticleBirthStart="1" ParticleBirthMin="1" ParticleBirthMax="2" ParticleBirthDecrease="1" ParticleBirthIncrease="1" />

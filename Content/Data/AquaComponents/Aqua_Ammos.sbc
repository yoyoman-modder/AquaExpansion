    <Ammos>
        <Ammo xsi:type="MyObjectBuilder_MissileAmmoDefinition">
            <Id>
                <TypeId>AmmoDefinition</TypeId>
                <SubtypeId>Aqua_SmallTorpedo</SubtypeId>
            </Id>
            <BasicProperties>
                <DesiredSpeed>80</DesiredSpeed>
                <SpeedVariance>0</SpeedVariance>
                <MaxTrajectory>200</MaxTrajectory>
                <IsExplosive>true</IsExplosive>
                <BackkickForce>0</BackkickForce>
                <PhysicalMaterial>Missile</PhysicalMaterial>
                <ExplosiveDamageMultiplier>2</ExplosiveDamageMultiplier>
				<EndOfLifeSound>WepSmallWarheadExpl</EndOfLifeSound>
				<EndOfLifeEffect>Explosion_Warhead_02</EndOfLifeEffect>
                <DeathMessage>CauseOfDeath_HeavyWeapons</DeathMessage>
            </BasicProperties>
            <MissileProperties>
                <MissileMass>50</MissileMass>
                <MissileExplosionRadius>5</MissileExplosionRadius>
                <MissileModelName>Models\Weapons\Aqua_SmallTorpedo.mwm</MissileModelName>
                <MissileAcceleration>20</MissileAcceleration>
                <MissileInitialSpeed>20</MissileInitialSpeed>
                <MissileSkipAcceleration>false</MissileSkipAcceleration>
                <MissileExplosionDamage>400</MissileExplosionDamage>
                <MissileTrailEffect>AquaMissileTrail</MissileTrailEffect>
            </MissileProperties>
        </Ammo>
